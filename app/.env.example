# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flamenodes

# Redis (BullMQ Queue System)
REDIS_URL=redis://localhost:6379

# App Configuration
APP_URL=http://localhost:3000
NODE_ENV=development

# Pterodactyl Panel (for auto-deployment)
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_API_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PTERO_DEFAULT_USER_ID=1
PTERO_DEFAULT_NEST=1
PTERO_DEFAULT_EGG=1

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx

# Email (Resend - optional)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=FlameNodes <noreply@flamenodes.com>

# Socket Server (for real-time updates)
SOCKET_SERVER_URL=http://localhost:4000
SOCKET_SERVER_SECRET=your-secret-key
